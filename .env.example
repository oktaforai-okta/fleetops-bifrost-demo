# Copy to .env and fill in from your own tenant. .env is gitignored and must stay that
# way: every value below is specific to one Okta org, and the private key is a live
# credential.
#
# Nothing real belongs in this file in the repo. If you find yourself pasting a wlp id
# or an aus id into .env.example rather than .env, stop.

# --- Okta tenant ---------------------------------------------------------------------

# Hostname only, no scheme.
OKTA_DOMAIN=your-tenant.oktapreview.com

# The agent's workload principal id, from Directory > AI Agents.
OKTA_AGENT_ID=wlp000000000000000000

# The agent's own A2A resource URL, from its dual-citizenship registration.
# This is what the CALLER's token must carry as its audience. Registering an agent as a
# resource is console-only, the API returns 405, and this URL cannot be edited later.
OKTA_AGENT_RESOURCE_URL=https://fleetops.atko.example/agent

# The agent's PRIVATE key as a JWK, on one line, as a JSON string.
# Okta shows the private key exactly once when the key pair is generated. If you missed
# it, generate a new key rather than trying to recover this one.
#
# Note this is substituted into the config as raw JSON, not as a quoted string, so it
# must be valid JSON on its own.
OKTA_AGENT_PRIVATE_KEY_JWK={"kty":"RSA","kid":"replace-me","n":"...","e":"AQAB","d":"...","p":"...","q":"..."}

# --- The two lanes -------------------------------------------------------------------
# Read and command are deliberately separate authorization servers. That way asking for
# a command scope on the read lane fails at the lane boundary instead of being quietly
# narrowed, because Okta fails the whole request rather than granting a subset.

OKTA_READ_LANE_AS_ID=aus000000000000000000
OKTA_COMMAND_LANE_AS_ID=aus000000000000000000

# The resource URL for each lane, sent as `resource` on the exchange. Okta stamps this
# into the token's aud claim, so these are the values the Fleet Ops server validates
# against, NOT the authorization servers' `audiences` setting.
FLEETOPS_READ_RESOURCE_URL=https://fleetops.atko.example/telemetry
FLEETOPS_COMMAND_RESOURCE_URL=https://fleetops.atko.example/dispatch

# --- Fleet Ops server ----------------------------------------------------------------
# Comma-separated. The server trusts both lanes and lets scope decide which tool a
# given token can reach. Issuers are https://<domain>/oauth2/<authorization server id>.

FLEETOPS_ISSUERS=https://your-tenant.oktapreview.com/oauth2/aus000000000000000000,https://your-tenant.oktapreview.com/oauth2/aus000000000000000000
FLEETOPS_AUDIENCES=https://fleetops.atko.example/telemetry,https://fleetops.atko.example/dispatch

# --- Bifrost -------------------------------------------------------------------------
# Pin this. A Go plugin is a shared object and will refuse to load unless the Bifrost
# binary was built with the same Go version AND the same versions of every shared
# dependency. `latest` will eventually drift and the plugin will stop loading with a
# message that does not obviously point at the cause.
BIFROST_IMAGE=maximhq/bifrost:latest
