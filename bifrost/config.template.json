{
  "$schema": "https://www.getbifrost.ai/schema",

  "client": {
    "allowed_origins": ["*"],
    "enable_logging": true
  },

  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": { "path": "/app/data/bifrost.db" }
  },

  "mcp": {
    "client_configs": [
      {
        "name": "fleetops_read",
        "client_id": "fleetops_read",
        "connection_type": "http",
        "connection_string": "http://fleetops:8080/mcp",

        "auth_type": "none",

        "needs_session_stickiness": false,

        "tools_to_execute": ["get_telemetry", "list_routes"]
      },
      {
        "name": "fleetops_command",
        "client_id": "fleetops_command",
        "connection_type": "http",
        "connection_string": "http://fleetops:8080/mcp",
        "auth_type": "none",
        "needs_session_stickiness": false,
        "tools_to_execute": ["dispatch_vehicle"]
      }
    ]
  },

  "plugins": [
    {
      "enabled": true,
      "name": "okta-agent-identity",
      "path": "/etc/bifrost/plugins/okta-agent-identity-${PLUGIN_ARCH}.so",
      "placement": "pre_builtin",
      "config": {
        "okta_domain": "${OKTA_DOMAIN}",
        "agent_id": "${OKTA_AGENT_ID}",
        "agent_resource_url": "${OKTA_AGENT_RESOURCE_URL}",
        "private_key_jwk_file": "/secrets/sentinel-intake-key.jwk",
        "agent_status_ttl": "10s",
        "fail_open": false,

        "allow_connect_without_caller": true,
        "bindings": {
          "fleetops_read": {
            "authorization_server_id": "${OKTA_COMMAND_LANE_AS_ID}",
            "target_resource_url": "${FLEETOPS_COMMAND_RESOURCE_URL}",
            "scopes": ["agent.invoke", "task.read"],
            "tools": ["fleetops_read-get_telemetry", "fleetops_read-list_routes"]
          },
          "fleetops_command": {
            "authorization_server_id": "${OKTA_COMMAND_LANE_AS_ID}",
            "target_resource_url": "${FLEETOPS_COMMAND_RESOURCE_URL}",
            "scopes": ["agent.invoke", "task.dispatch"],
            "tools": ["fleetops_command-dispatch_vehicle"]
          }
        }
      }
    }
  ]
}
