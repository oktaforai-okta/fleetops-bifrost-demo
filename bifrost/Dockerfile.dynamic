# A dynamically linked Bifrost, which is what plugin support requires.
#
# This is not a workaround. Bifrost's published images are statically linked on purpose,
# for portability across libc implementations, and Go's plugin system cannot load a .so
# into a statically linked host. Their own docs say so: see
# https://docs.getbifrost.ai/plugins/building-dynamic-binary
#
# So running ANY Bifrost plugin means building and maintaining your own Bifrost binary.
# That is a real operational cost, and it is worth knowing before choosing the plugin
# route over the alternatives.
#
# The difference from their published build is one linker flag: they pass
# -extldflags '-static', and this does not.

ARG GO_IMAGE=golang:1.27.0-alpine3.24
# Their own Dockerfile builds the console on node:25-alpine3.23. Keep this in step with
# it: the UI is their source and their lockfile, so their toolchain is the tested one.
ARG NODE_IMAGE=node:25-alpine3.23
ARG RUNTIME_IMAGE=alpine:3.23

# --- source ----------------------------------------------------------------------------
# One clone, shared by the UI stage and the Go stage. Cloning once rather than in each
# stage keeps the two from ever being built from different commits, which would produce a
# console and a server that disagree about the admin API.
FROM ${GO_IMAGE} AS source

# Which Bifrost to build. Pin this: the plugin must be compiled against the same
# bifrost/core version this transports tag depends on, or it will not load. Check with
# `make compat` in the plugin repo.
ARG BIFROST_REF=transports/v2.0.0

RUN apk add --no-cache gcc musl-dev sqlite-dev git file

# Optional corporate CA, for networks that intercept TLS. Without this, the git clone
# below fails with an unknown-authority error. Harmless when the directory holds only
# its README.
COPY certs/ /tmp/certs/
RUN if [ -f /tmp/certs/ca-bundle.crt ]; then \
      cat /tmp/certs/ca-bundle.crt >> /etc/ssl/certs/ca-certificates.crt && \
      echo "added local CA bundle to the build trust store" ; \
    fi

WORKDIR /src
RUN git clone --depth 1 --branch "${BIFROST_REF}" https://github.com/maximhq/bifrost.git .

# --- ui-builder ------------------------------------------------------------------------
# The admin console is embedded with `//go:embed all:ui`, so the directory must exist and
# be non-empty at Go build time. This stage produces it the way their own Dockerfile does:
# their lockfile, their build script, their output directory. Nothing here is ours.
#
# The Node toolchain never reaches the runtime image. Only the built assets do, and they
# arrive inside the Go binary, so the cost of this stage is build time rather than image
# size.
FROM ${NODE_IMAGE} AS ui-builder
WORKDIR /ui

# Same TLS-interception case as the clone above, except npm reaches the registry through
# Node's own trust store rather than the system one, so the bundle has to be handed to
# Node directly. Set per-command rather than with ENV, because pointing
# NODE_EXTRA_CA_CERTS at a file that does not exist makes Node warn on every invocation.
COPY certs/ /tmp/certs/

# package files first, so a source-only change does not re-run the install.
COPY --from=source /src/ui/package.json /src/ui/package-lock.json ./
# NODE_ENV is deliberately left alone: vite, typescript and tailwind are devDependencies,
# and `npm ci` under NODE_ENV=production would skip them and fail the build below.
RUN if [ -f /tmp/certs/ca-bundle.crt ]; then \
      export NODE_EXTRA_CA_CERTS=/tmp/certs/ca-bundle.crt && \
      echo "handed local CA bundle to node for the npm install" ; \
    fi ; \
    npm ci

COPY --from=source /src/ui/ ./

# build-enterprise is `vite build && tsc --noEmit`, which is the script their Dockerfile
# runs. It skips their copy-build step, which would write into ../transports; the Go stage
# below copies the output instead.
#
# Despite the name this is the open-source console: the build only turns on enterprise
# features when ui/app/enterprise exists, and in the public repo it does not.
RUN npm run build-enterprise

# --- builder ---------------------------------------------------------------------------
# FROM source, so the clone and the build trust store are inherited rather than repeated.
FROM source AS builder
WORKDIR /src/transports

COPY --from=ui-builder /ui/out bifrost-http/ui

# `//go:embed all:ui` is satisfied by ANY non-empty directory, including a stub, so a
# broken UI build does not fail the Go build: it produces a server that boots and serves a
# blank page. Assert the real thing is there instead. Vite emits an index.html that loads
# a hashed bundle out of assets/, which a stub will not have.
RUN test -s bifrost-http/ui/index.html \
      && grep -q 'assets/' bifrost-http/ui/index.html \
      && echo "OK: admin console is built and embedded" \
      || (echo "ERROR: bifrost-http/ui is not a built console" && \
          ls -la bifrost-http/ui && exit 1)

ENV CGO_ENABLED=1 GOOS=linux GOWORK=off
ARG VERSION=dynamic-local

# No -extldflags '-static'. That single omission is what makes plugin loading possible.
RUN go build \
      -ldflags="-w -s -X main.Version=v${VERSION}" \
      -trimpath \
      -o /out/main \
      ./bifrost-http

# Fail the build rather than discovering at runtime that plugins cannot load. The runtime
# symptom is "plugin.Open: Dynamic loading not supported", which does not obviously point
# at the linker.
RUN file /out/main | grep -q "dynamically linked" \
      && echo "OK: dynamically linked, plugins can load" \
      || (echo "ERROR: statically linked, plugins will NOT load" && file /out/main && exit 1)

FROM ${RUNTIME_IMAGE}
WORKDIR /app

# musl and libgcc are needed because the binary is dynamically linked against them.
RUN apk add --no-cache musl libgcc ca-certificates wget

COPY --from=builder /out/main /app/main
COPY --from=builder /src/transports/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh && mkdir -p /app/data

ENV APP_PORT=8080 \
    APP_HOST=0.0.0.0 \
    LOG_LEVEL=info \
    LOG_STYLE=json \
    APP_DIR=/app/data

EXPOSE 8080
ENTRYPOINT ["/app/docker-entrypoint.sh"]
