# Rendered from bifrost/config.template.json at startup. Contains the agent's private
# key and every tenant identifier. Must never be committed.
bifrost/config.json

# Real values live here.
.env
.env.local

# Built plugin artifacts, if anyone copies them in.
*.so
bin/

# Compiled binary, written into the mount by a containerised go build.
server/server
driver/driver
# `go build ./...` names the binary after its directory, so both spellings appear
# depending on whether it was built by hand or by render.yaml's buildCommand.
sentinel/api/api
sentinel/api/sentinel-api

# Local CA bundles for TLS-intercepting networks. Machine-specific, never committed.
certs/*
!certs/README.md

# Agent private key. Never committed.
secrets/*
!secrets/README.md
